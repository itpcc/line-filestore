ACCESS_TOKEN=<LINE bot "long-lived" access token>
CHANNEL_SECRET=<LINE bot channel secret>
ALLOW_USER_IDS=<List of allowed Line bot user ID. comman-separated>
FILESTORE_PATH=<folder to store files. absolute path>
# See https://docs.paperless-ngx.com/api/#file-uploads
PAPERLESS_URL=<URL to Paperless web with protocol and domain>
# See https://docs.paperless-ngx.com/api/#authorization:~:text=Token%20authentication
PAPERLESS_API_AUTH_TOKEN=<User API auth token>
PAPERLESS_CORRESPONDENT=<ID of file correspondent>
PAPERLESS_STORAGE_PATH=<ID of storage path>
PAPERLESS_TAGS=<ID of document tag>
STIRLING_PDF_URL=<URL to stirling PDF service with port. e.g. http://localhost:25080>

# Directus Config
DIRECTUS_HOST=<URL to local Directus instance, e.g. http://localhost:8055>
DIRECTUS_TOKEN=<Static API token for Directus authentication>

# Google Drive Config
GDRIVE_FILE_SIZE_MAX_MB=50

# Optional: Explicitly specify authentication method (service_account | oauth | api_key)
# If omitted, service_account takes precedence if configured, followed by oauth, then api_key.
# GDRIVE_AUTH_METHOD=service_account

# Option 1: Personal User Account Authentication (OAuth 2.0) - Download files on behalf of your own account
GDRIVE_OAUTH_CLIENT_ID=<OAuth 2.0 Client ID>
GDRIVE_OAUTH_CLIENT_SECRET=<OAuth 2.0 Client Secret>
GDRIVE_OAUTH_REFRESH_TOKEN=<OAuth 2.0 Refresh Token for your personal Google Account>

# Option 2: Service Account (for organization/shared files)
GDRIVE_SERVICE_ACCOUNT_JSON=<Path to service account JSON file or raw JSON string>

# Option 3: API Key (for public files only)
GDRIVE_API_KEY=<Google Drive API Key>